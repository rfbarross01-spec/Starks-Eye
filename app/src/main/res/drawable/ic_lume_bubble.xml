<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#33000000" />
        </shape>
    </item>

    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/paper" />
            <stroke android:width="1dp" android:color="#1C1814" />
        </shape>
    </item>

    <item android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="#1C1814" />
        </shape>
    </item>

    <item android:left="22dp" android:top="22dp" android:right="22dp" android:bottom="22dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="14dp"
                android:startColor="#FFD9A48A"
                android:centerColor="#FFB85432"
                android:endColor="#FF8A3D24" />
        </shape>
    </item>

</layer-list>
